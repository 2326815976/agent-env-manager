<Window x:Class="AgentEnvManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent 环境管理"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        Background="#F5F7F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1D2B36"
                       Text="Agent 环境管理" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="#52616B"
                       Text="体检与纳管" />
        </DockPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <Button Content="扫描"
                    Command="{Binding ScanCommand}"
                    Padding="16,8"
                    Margin="0,0,8,0" />
            <Button Content="预览纳管"
                    Command="{Binding PreviewAdoptionCommand}"
                    Padding="16,8"
                    Margin="0,0,8,0" />
            <Button Content="确认纳管"
                    Command="{Binding AdoptCommand}"
                    Padding="16,8"
                    Margin="0,0,16,0" />
            <Button Content="预览切换"
                    Command="{Binding PreviewSwitchCommand}"
                    Padding="16,8"
                    Margin="0,0,8,0" />
            <Button Content="确认切换"
                    Command="{Binding SwitchCommand}"
                    Padding="16,8" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="环境清单">
                <DataGrid ItemsSource="{Binding Environments}"
                          SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderBrush="#D7DFE4"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="对象类型"
                                            Binding="{Binding TypeLabel}"
                                            Width="120" />
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="150" />
                        <DataGridTextColumn Header="版本"
                                            Binding="{Binding Version}"
                                            Width="120" />
                        <DataGridTextColumn Header="管理状态"
                                            Binding="{Binding ManagementStateLabel}"
                                            Width="110" />
                        <DataGridTextColumn Header="健康状态"
                                            Binding="{Binding HealthStateLabel}"
                                            Width="100" />
                        <DataGridTextColumn Header="位置"
                                            Binding="{Binding Location}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="体检报告">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding ReportGeneratedAt, StringFormat=生成时间：{0}}" />
                        <TextBlock Margin="0,16,0,4"
                                   FontWeight="SemiBold"
                                   Text="PATH 冲突" />
                        <ItemsControl ItemsSource="{Binding PathConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Label}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="#52616B"
                                                   Text="{Binding ScopesLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,16,0,4"
                                   FontWeight="SemiBold"
                                   Text="命令遮蔽冲突" />
                        <ItemsControl ItemsSource="{Binding CommandPathConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="操作中心"
                     DataContext="{Binding OperationCenter}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Content="刷新操作"
                                Command="{Binding RefreshCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="准备回滚"
                                Command="{Binding PrepareRollbackCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="确认回滚"
                                Command="{Binding ConfirmRollbackCommand}"
                                Padding="14,6" />
                        <TextBlock Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#52616B"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Operations}"
                              SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Background="White"
                              BorderBrush="#D7DFE4"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型"
                                                Binding="{Binding TypeLabel}"
                                                Width="120" />
                            <DataGridTextColumn Header="状态"
                                                Binding="{Binding StateLabel}"
                                                Width="110" />
                            <DataGridTextColumn Header="摘要"
                                                Binding="{Binding Summary}"
                                                Width="180" />
                            <DataGridTextColumn Header="目标"
                                                Binding="{Binding Target}"
                                                Width="220" />
                            <DataGridTextColumn Header="恢复点"
                                                Binding="{Binding RecoveryPointId}"
                                                Width="180" />
                            <DataGridTextColumn Header="更新时间"
                                                Binding="{Binding UpdatedAt}"
                                                Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding RollbackTarget, StringFormat=回滚目标：{0}}" />
                        <TextBlock Text="{Binding RollbackImpact, StringFormat=影响范围：{0}}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RollbackRecoveryPoint, StringFormat=恢复点：{0}}" />
                    </StackPanel>

                    <Expander Grid.Row="3"
                              Margin="0,10,0,0"
                              Header="恢复点">
                        <ListBox ItemsSource="{Binding RecoveryPoints}"
                                 MaxHeight="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding TypeLabel}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Description}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding CreatedAt}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="恢复隔离环境"
                                Command="{Binding RestoreQuarantineCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="预览永久清除"
                                Command="{Binding PreparePermanentDeleteCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="确认永久清除"
                                Command="{Binding ConfirmPermanentDeleteCommand}"
                                Padding="14,6"
                                Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#B42318"
                                   TextWrapping="Wrap"
                                   Text="{Binding PermanentDeleteImpact}" />
                    </StackPanel>

                    <DataGrid Grid.Row="5"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding QuarantinedEnvironments}"
                              SelectedItem="{Binding SelectedQuarantine, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              Background="White"
                              BorderBrush="#D7DFE4"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称"
                                                Binding="{Binding Name}"
                                                Width="140" />
                            <DataGridTextColumn Header="版本"
                                                Binding="{Binding Version}"
                                                Width="100" />
                            <DataGridTextColumn Header="原路径"
                                                Binding="{Binding OriginalPath}"
                                                Width="220" />
                            <DataGridTextColumn Header="隔离路径"
                                                Binding="{Binding QuarantinePath}"
                                                Width="220" />
                            <DataGridTextColumn Header="关联内容"
                                                Binding="{Binding AssociatedState}"
                                                Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="运行时管理"
                     DataContext="{Binding RuntimeCenter}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="加载提供者"
                                Command="{Binding LoadProvidersCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="预览安装"
                                Command="{Binding PreviewInstallCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="确认安装"
                                Command="{Binding InstallCommand}"
                                Padding="14,6"
                                Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#52616B"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  Background="White"
                                  BorderBrush="#D7DFE4"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称"
                                                    Binding="{Binding Name}"
                                                    Width="110" />
                                <DataGridTextColumn Header="版本"
                                                    Binding="{Binding VersionLabel}"
                                                    Width="80" />
                                <DataGridTextColumn Header="安装状态"
                                                    Binding="{Binding StatusLabel}"
                                                    Width="80" />
                                <DataGridTextColumn Header="许可证"
                                                    Binding="{Binding License}"
                                                    Width="90" />
                                <DataGridTextColumn Header="官方来源"
                                                    Binding="{Binding Source}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SelectedProvider.Name, StringFormat=依赖：{0}}" />
                            <TextBlock Foreground="#52616B"
                                       Text="{Binding SelectedProvider.KindLabel, StringFormat=类型：{0}}" />
                            <TextBlock Foreground="#52616B"
                                       Text="{Binding SelectedProvider.ModeLabel, StringFormat=模式：{0}}" />
                            <TextBlock Foreground="#52616B"
                                       Text="{Binding SelectedProvider.ManagedVersionLabel, StringFormat=已纳管版本：{0}}" />
                            <TextBlock Foreground="#52616B"
                                       Text="{Binding SelectedProvider.ManagedEntryLabel, StringFormat=当前受管入口：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold"
                                       Margin="0,10,0,0"
                                       Text="版本与安装" />
                            <ComboBox Margin="0,6,0,0"
                                      MinWidth="240"
                                      ItemsSource="{Binding SelectedProvider.Artifacts}"
                                      SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                                      DisplayMemberPath="Version" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#52616B"
                                       Text="{Binding SelectedArtifact.StrategyLabel, StringFormat=安装策略：{0}}" />
                            <TextBlock Foreground="#52616B"
                                       Text="{Binding SelectedArtifact.Sha256, StringFormat=SHA-256：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="镜像地址（可选）" />
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding MirrorUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="安装目录（留空使用管理器数据根目录）" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding InstallRoot, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="选择"
                                        Command="{Binding SelectInstallRootCommand}"
                                        Margin="4,0,0,0" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding InstallImpact, StringFormat=影响范围：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingTarget, StringFormat=安装目录：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingRecoveryPoint, StringFormat=恢复点：{0}}" />
                            <TextBlock Text="{Binding PendingManagedEntry, StringFormat=受管入口：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingActivationPath, StringFormat=稳定激活路径：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingCacheStatus}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding InstallResult}"
                                       TextWrapping="Wrap" />

                            <Separator Margin="0,14" />

                            <TextBlock FontWeight="SemiBold"
                                       Text="离线制品" />
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding ArtifactPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="导入并校验"
                                    Command="{Binding ImportArtifactCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Margin="0,8,0,0" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding ImportResult}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="环境变量"
                     DataContext="{Binding EnvironmentVariables}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="加载环境变量"
                                Command="{Binding LoadCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="预览变更"
                                Command="{Binding PreviewCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="应用变更"
                                Command="{Binding ApplyCommand}"
                                Padding="14,6"
                                Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#52616B"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="140" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold"
                                       Text="受管入口（高风险，勾选后需预览并确认再写入用户 PATH）" />
                            <DataGrid Grid.Row="1"
                                      Margin="0,6,0,0"
                                      ItemsSource="{Binding PathEntries}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      Background="White"
                                      BorderBrush="#D7DFE4"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="启用"
                                                            Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="56" />
                                    <DataGridTextColumn Header="名称"
                                                        Binding="{Binding Name}"
                                                        Width="110" />
                                    <DataGridTextColumn Header="版本"
                                                        Binding="{Binding Version}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="受管入口"
                                                        Binding="{Binding ManagedEntryPath}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       Text="其他 PATH 条目（只读）" />
                            <DataGrid Grid.Row="3"
                                      Margin="0,6,0,0"
                                      ItemsSource="{Binding ExternalPathEntries}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      Background="White"
                                      BorderBrush="#D7DFE4"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="条目"
                                                        Binding="{Binding Entry}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="编辑"
                                                        Binding="{Binding EditabilityLabel}"
                                                        Width="56" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="管理器拥有的环境变量" />
                            <DataGrid Margin="0,6,0,0"
                                      MinHeight="240"
                                      ItemsSource="{Binding Variables}"
                                      SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      Background="White"
                                      BorderBrush="#D7DFE4"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="变量名"
                                                        Binding="{Binding Name}"
                                                        IsReadOnly="True"
                                                        Width="240" />
                                    <DataGridTextColumn Header="值"
                                                        Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewVariableName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="变量名" />
                                <TextBox Grid.Column="1"
                                         Margin="6,0,0,0"
                                         Text="{Binding NewVariableValue, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="变量值" />
                                <Button Grid.Column="2"
                                        Content="添加或更新"
                                        Command="{Binding AddVariableCommand}"
                                        Margin="6,0,0,0"
                                        Padding="12,4" />
                                <Button Grid.Column="3"
                                        Content="删除所选"
                                        Command="{Binding RemoveVariableCommand}"
                                        Margin="6,0,0,0"
                                        Padding="12,4" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Text="{Binding PreviewImpact, StringFormat=影响范围：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingRecoveryPoint, StringFormat=恢复点：{0}}" />

                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="SemiBold"
                                       Text="用户其他变量（只读）" />
                            <DataGrid Margin="0,6,0,0"
                                      Height="120"
                                      ItemsSource="{Binding ExternalVariables}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      Background="White"
                                      BorderBrush="#D7DFE4"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="变量名"
                                                        Binding="{Binding Name}"
                                                        Width="220" />
                                    <DataGridTextColumn Header="值"
                                                        Binding="{Binding ValueLabel}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="编辑"
                                                        Binding="{Binding EditabilityLabel}"
                                                        Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="SemiBold"
                                       Text="机器级变量（只读）" />
                            <TextBlock Foreground="#52616B"
                                       Text="{Binding MachineScopeNote}"
                                       TextWrapping="Wrap" />
                            <DataGrid Margin="0,6,0,0"
                                      Height="120"
                                      ItemsSource="{Binding MachineVariables}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      Background="White"
                                      BorderBrush="#D7DFE4"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="变量名"
                                                        Binding="{Binding Name}"
                                                        Width="220" />
                                    <DataGridTextColumn Header="值"
                                                        Binding="{Binding ValueLabel}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="编辑"
                                                        Binding="{Binding EditabilityLabel}"
                                                        Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="诊断包"
                     DataContext="{Binding DiagnosticsPackage}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button Content="生成预览"
                                Command="{Binding PreviewCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="导出到本地"
                                Command="{Binding ExportCommand}"
                                Padding="14,6"
                                Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#52616B"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,10">
                        <TextBlock Text="{Binding Impact}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TelemetryLabel, StringFormat=遥测：{0}}" />
                        <TextBlock Text="{Binding AutomaticUploadLabel, StringFormat=自动上传：{0}}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding Entries}"
                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  Background="White"
                                  BorderBrush="#D7DFE4"
                                  BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="条目"
                                                    Binding="{Binding Name}"
                                                    Width="130" />
                                <DataGridTextColumn Header="说明"
                                                    Binding="{Binding Description}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding SelectedEntry.Content, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="1"
                                        Margin="0,10,0,0">
                                <TextBlock Text="本地导出路径" />
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       Text="{Binding ExportResult}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="迁移"
                     DataContext="{Binding MigrationCenter}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="预览迁移"
                                Command="{Binding PreviewMigrationCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="确认迁移"
                                Command="{Binding MigrateCommand}"
                                Padding="14,6"
                                Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#52616B"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="已纳管环境" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SelectedEnvironment.Name, StringFormat=名称：{0}}" />
                            <TextBlock Text="{Binding SelectedEnvironment.Version, StringFormat=版本：{0}}" />
                            <TextBlock Text="{Binding SelectedEnvironment.Location, StringFormat=当前位置：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedEnvironment.Fingerprint.Value, StringFormat=指纹：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,16,0,0"
                                       Text="迁移目标路径" />
                            <TextBox Margin="0,4,0,0"
                                     Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding MigrationImpact, StringFormat=影响范围：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding PendingTarget, StringFormat=目标路径：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingRecoveryPoint, StringFormat=恢复点：{0}}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding ExpectedResult, StringFormat=预期结果：{0}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Agent 绑定"
                     DataContext="{Binding AgentBinding}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <ComboBox Width="120"
                                  ItemsSource="{Binding AvailableAgents}"
                                  SelectedItem="{Binding SelectedAgent, Mode=TwoWay}" />
                        <Button Content="发现 Agent"
                                Command="{Binding DiscoverCommand}"
                                Padding="14,6"
                                Margin="8,0,8,0" />
                        <Button Content="预览绑定"
                                Command="{Binding PreviewBindingCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="执行绑定"
                                Command="{Binding BindCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Content="健康检查"
                                Command="{Binding HealthCheckCommand}"
                                Padding="14,6"
                                Margin="0,0,16,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#52616B"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Agent 配置环境" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ConfigurationDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="选择"
                                            Command="{Binding SelectConfigurationDirectoryCommand}"
                                            Margin="4,0,0,0" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="可执行文件" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="选择"
                                            Command="{Binding SelectExecutableCommand}"
                                            Margin="4,0,0,0" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="受管入口" />
                                <TextBox Text="{Binding ManagedEntryPath, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="选择运行时" />
                                <ComboBox ItemsSource="{Binding AvailableRuntimeOptions}"
                                          SelectedItem="{Binding SelectedRuntimeOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="运行时名称" />
                                <TextBox Text="{Binding RuntimeName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="运行时版本" />
                                <TextBox Text="{Binding RuntimeVersion, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="工作区（可选）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="选择"
                                            Command="{Binding SelectWorkspaceCommand}"
                                            Margin="4,0,0,0" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="运行时命令（可选）" />
                                <TextBox Text="{Binding RuntimeCommand, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding DiscoveryResult}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding BindingFilePath, StringFormat=绑定文件：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding RecoveryPointInformation, StringFormat=配置恢复点：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding BindingSummary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding RecoveryResult, StringFormat=恢复结果：{0}}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding HealthResult}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="3"
                   Margin="0,12,0,0"
                   Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding PendingTarget, StringFormat=目标：{0}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding PendingRecoveryPoint}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding AdoptionImpact}"
                           MaxWidth="640"
                           TextWrapping="Wrap"
                           Foreground="#7A4A00" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
